@model Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-gradient-primary text-white d-flex align-items-center" style="background: linear-gradient(90deg,#0d6efd,#6610f2);">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-box-seam me-2" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8.354.146a.5.5 0 0 0-.708 0L1.5 6.293V8l6.146 5.854a.5.5 0 0 0 .708 0L14.5 8V6.293L8.354.146zM2.062 6.5L8 1.12 13.938 6.5 8 11.88 2.062 6.5zM1 7.5v5a1 1 0 0 0 1 1h1v-5L1 7.5zm12 6a1 1 0 0 0 1-1v-5l-2 .5v5h1z"/>
            </svg>
            <h4 class="mb-0">Nuevo Producto</h4>
        </div>

        <div class="card-body">
            <form id="formProducto" asp-action="Crear" method="post" onsubmit="return validarFormulario();" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold text-primary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#0d6efd" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3z"/>
                                        <path fill-rule="evenodd" d="M8 8a3 3 0 100-6 3 3 0 000 6z"/>
                                    </svg>
                                </span>
                                <input asp-for="Nombre" class="form-control border-start-0" id="Nombre" placeholder="Ej. Jabón Líquido" maxlength="50" />
                            </div>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-primary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#6610f2" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3 2.5a.5.5 0 00-.5.5v10a.5.5 0 00.5.5h10a.5.5 0 00.5-.5V5.707a1 1 0 00-.293-.707L11.293 2.293A1 1 0 0010.586 2H3z"/>
                                    </svg>
                                </span>
                                <textarea asp-for="Descripcion" class="form-control border-start-0" id="Descripcion" rows="3" placeholder="Breve descripción"></textarea>
                            </div>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label fw-semibold text-primary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#198754" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M8 0a5 5 0 00-5 5v1H1.5A1.5 1.5 0 000 7.5v7A1.5 1.5 0 001.5 16h13A1.5 1.5 0 0016 14.5v-7A1.5 1.5 0 0014.5 6H13V5a5 5 0 00-5-5zM4 6V5a4 4 0 018 0v1H4z"/>
                                    </svg>
                                </span>
                                <input asp-for="Precio" type="number" step="0.01" min="0.01" max="9999.99" class="form-control border-start-0" id="Precio" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Stock" class="form-label fw-semibold text-primary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#fd7e14" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M2.5 1.5A1.5 1.5 0 001 3v10a1.5 1.5 0 001.5 1.5h11A1.5 1.5 0 0015 13V3a1.5 1.5 0 00-1.5-1.5h-11zM3 4h10v8H3V4z"/>
                                </span>
                                <input asp-for="Stock" type="number" min="0" max="1000" class="form-control border-start-0" id="Stock" placeholder="0" />
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaVencimiento" class="form-label fw-semibold text-primary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#0dcaf0" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M3.5 0a.5.5 0 01.5.5V1h8V.5a.5.5 0 011 0V1h.5A1.5 1.5 0 0115 2.5V4H1V2.5A1.5 1.5 0 012.5 1H3V.5a.5.5 0 01.5-.5zM1 5v8.5A1.5 1.5 0 002.5 15H13.5A1.5 1.5 0 0015 13.5V5H1z"/>
                                    </svg>
                                </span>
                                <input asp-for="FechaVencimiento" type="date" class="form-control border-start-0" id="FechaVencimiento" />
                            </div>
                            <span asp-validation-for="FechaVencimiento" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descuento" class="form-label fw-semibold text-primary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#dc3545" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M6.5 0a.5.5 0 00-.354.146L.146 6.146a.5.5 0 000 .708L6.146 13.06a.5.5 0 00.708 0L13.854 6.56a.5.5 0 000-.708L7.207.146A.5.5 0 006.5 0zM3 7.5a1 1 0 110-2 1 1 0 010 2z"/>
                                </span>
                                <input asp-for="Descuento" type="number" min="0" max="100" class="form-control border-start-0" id="Descuento" placeholder="0" />
                                <span class="input-group-text bg-white border-start-0">%</span>
                            </div>
                            <div class="form-text small text-muted">Rango: 0 - 100%</div>
                            <span asp-validation-for="Descuento" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle me-1" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 15A7 7 0 118 1a7 7 0 010 14zM4.646 4.646a.5.5 0 01.708 0L8 7.293l2.646-2.647a.5.5 0 11.708.708L8.707 8l2.647 2.646a.5.5 0 01-.708.708L8 8.707l-2.646 2.647a.5.5 0 01-.708-.708L7.293 8 4.646 5.354a.5.5 0 010-.708z"/>
                        </svg>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check2-circle me-1" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M2.5 8a5.5 5.5 0 1011 0 5.5 5.5 0 00-11 0zM6.002 10.5L4 8.5l.707-.707L6 9.086l5.293-5.293L12 4.5 6.002 10.5z"/>
                        </svg>
                        Guardar
                    </button>
                </div>
            </form>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-success mt-3">@ViewBag.Mensaje</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Validación centralizada: comprobar campos personalizados primero (alertas),
        // luego delegar en la validación unobtrusive.
        function validarFormulario() {
            const nombre = document.getElementById("Nombre")?.value?.trim() ?? "";

            // VALIDACIÓN PERSONALIZADA: alerta inmediata si Nombre vacío
            if (!nombre) {
                alert("El nombre es obligatorio");
                const nombreEl = document.getElementById("Nombre");
                if (nombreEl) nombreEl.focus();
                return false;
            }

            // ahora ejecutar validación unobtrusive si está disponible
            if (window.jQuery && typeof jQuery === "function") {
                var $form = jQuery('#formProducto');
                if ($form.length && typeof $form.valid === "function") {
                    // Si no es válida, dejar que los mensajes de validation aparezcan
                    if (!$form.valid()) {
                        return false;
                    }
                }
            }

            // resto de validaciones personalizadas (si las necesitas)
            const descripcion = document.getElementById("Descripcion")?.value?.trim() ?? "";
            const precioVal = document.getElementById("Precio")?.value;
            const stockVal = document.getElementById("Stock")?.value;
            const fechaVal = document.getElementById("FechaVencimiento")?.value;
            const descuentoVal = document.getElementById("Descuento")?.value;

            const precio = precioVal ? parseFloat(precioVal) : NaN;
            const stock = stockVal ? parseInt(stockVal, 10) : NaN;
            const descuento = (descuentoVal !== undefined && descuentoVal !== null && descuentoVal !== "") ? Number(descuentoVal) : null;

            if (descripcion.length === 0) {
                alert("La descripción es obligatoria");
                const descEl = document.getElementById("Descripcion");
                if (descEl) descEl.focus();
                return false;
            }

            if (isNaN(precio) || precio < 0.01 || precio > 9999.99) {
                alert("El precio debe estar entre 0.01 y 9999.99");
                const precioEl = document.getElementById("Precio");
                if (precioEl) precioEl.focus();
                return false;
            }

            if (isNaN(stock) || stock < 0 || stock > 1000) {
                alert("El stock debe estar entre 0 y 1000");
                const stockEl = document.getElementById("Stock");
                if (stockEl) stockEl.focus();
                return false;
            }

            if (descuento !== null && stock < 10 && descuento > 20) {
                alert("Si el stock es menor a 10, el descuento no puede superar el 20%");
                const descEl = document.getElementById("Descuento");
                if (descEl) descEl.focus();
                return false;
            }

            if (fechaVal) {
                const seleccionada = new Date(fechaVal + "T00:00:00");
                const hoy = new Date();
                hoy.setHours(0,0,0,0);
                if (seleccionada <= hoy) {
                    alert("La fecha de vencimiento, si se especifica, debe ser mayor que la fecha actual");
                    const fechaEl = document.getElementById("FechaVencimiento");
                    if (fechaEl) fechaEl.focus();
                    return false;
                }
            }

            if (descuento !== null) {
                if (!Number.isInteger(descuento) || descuento < 0 || descuento > 100) {
                    alert("El descuento debe ser un entero entre 0 y 100");
                    const descEl = document.getElementById("Descuento");
                    if (descEl) descEl.focus();
                    return false;
                }
            }

            return true;
        }
    </script>
}
