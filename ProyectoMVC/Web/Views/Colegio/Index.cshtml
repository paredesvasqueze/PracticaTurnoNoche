@model IEnumerable<Models.Colegio>

@{
    ViewData["Title"] = "Colegios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Colegios</h1>
        <small class="text-muted">Lista de colegios registrados</small>
    </div>
    <div>
        <a class="btn btn-lg btn-primary" asp-controller="Colegio" asp-action="Create">+ Crear Nuevo</a>
    </div>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th class="small">Id</th>
                <th>Nombre</th>
                <th class="small">RUC</th>
                <th>Dirección</th>
                <th class="small">Teléfono</th>
                <th>Email</th>
                <th>Director</th>
                <th class="small">Estado</th>
                <th class="text-end small">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-4 text-muted">No hay colegios registrados.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="small text-muted">@item.IdColegio</td>
                        <td>@item.Nombre</td>
                        <td class="small">@item.RUC</td>
                        <td>@item.Direccion</td>
                        <td class="small">@item.Telefono</td>
                        <td>@item.Email</td>
                        <td>@item.Director</td>
                        <td>
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary me-1" asp-controller="Colegio" asp-action="Edit" asp-route-id="@item.IdColegio">Editar</a>
                            <a class="btn btn-sm btn-info text-white me-1" asp-controller="Colegio" asp-action="Details" asp-route-id="@item.IdColegio">Detalles</a>
                            <form asp-controller="Colegio" asp-action="Delete" asp-route-id="@item.IdColegio" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar este colegio?');">
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Mantener simple: si quieres confirmaciones con SweetAlert2 indícamelo y adapto.
    </script>
}
