@model Models.Docentes

<form id="formDocente">
    <input type="hidden" id="IdDocente" value="@Model.IdDocente" />

    <div class="mb-3">
        <label for="IdColegio" class="form-label">Id Colegio</label>
        <input type="number" class="form-control" id="IdColegio" value="@Model.IdColegio" />
    </div>

    <div class="mb-3">
        <label for="Nombres" class="form-label">Nombres</label>
        <input type="text" class="form-control" id="Nombres" value="@Model.Nombres" />
    </div>

    <div class="mb-3">
        <label for="Apellidos" class="form-label">Apellidos</label>
        <input type="text" class="form-control" id="Apellidos" value="@Model.Apellidos" />
    </div>

    <div class="mb-3">
        <label for="DNI" class="form-label">DNI</label>
        <input type="text" class="form-control" id="DNI" value="@Model.DNI" />
    </div>

    <div class="mb-3">
        <label for="Email" class="form-label">Email</label>
        <input type="email" class="form-control" id="Email" value="@Model.Email" />
    </div>

    <div class="mb-3">
        <label for="Telefono" class="form-label">Teléfono</label>
        <input type="text" class="form-control" id="Telefono" value="@Model.Telefono" />
    </div>

    <div class="mb-3">
        <label for="Especialidad" class="form-label">Especialidad</label>
        <input type="text" class="form-control" id="Especialidad" value="@Model.Especialidad" />
    </div>

    <div class="mb-3">
        <label for="FechaIngreso" class="form-label">Fecha Ingreso</label>
        <input type="date" class="form-control" id="FechaIngreso" value="@(Model.FechaIngreso == default ? "" : Model.FechaIngreso.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="Estado" @(Model.Estado ? "checked" : "") />
        <label for="Estado" class="form-check-label">Activo</label>
    </div>

    <div class="text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-success" onclick="guardarDocente()">Guardar</button>
    </div>
</form>
